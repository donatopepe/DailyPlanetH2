# Esempio di configurazione per docker compose.
#
# Copiare questo file in `.env` e sostituire i valori con credenziali reali.
# Il file `.env` è in .gitignore: non committare mai credenziali.
#
#   cp .env.example .env
#
# I valori qui sotto sono segnaposto e non funzionano in produzione.

# --- database PostgreSQL gestito dal servizio "db" ---
POSTGRES_DB=dailyplanet
POSTGRES_USER=dailyplanet
POSTGRES_PASSWORD=cambiami-password-database

# --- account amministratore creato al primo avvio ---
# Al primo accesso il portale obbliga al cambio password.
DAILYPLANET_ADMIN_USERNAME=administrator
DAILYPLANET_ADMIN_EMAIL=admin@example.invalid
DAILYPLANET_ADMIN_PASSWORD=cambiami-password-amministratore

# --- porte pubblicate sull'host ---
APP_PORT=8080
POSTGRES_PORT=5432
