# Build Gradle
build/
.gradle/

# Database locale H2
*.h2.db
*.mv.db
*.trace.db

# CodeGraph (indice locale)
.codegraph/

# Loop agent locale
.pi-loop.json
.pi-loop.json.lock

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Variabili d'ambiente locali (mai committare credenziali)
.env

# Il wrapper Gradle DEVE essere versionato (build riproducibile da un clone pulito).
# Attenzione: l'eccezione va DOPO la regola *.jar, altrimenti quest'ultima la annulla.
!gradle/wrapper/gradle-wrapper.jar
