# EditorConfig: https://editorconfig.org
# The repository is always stored with LF endings (see .gitattributes);
# Windows-only scripts are checked out as CRLF.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,md}]
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{gradle,properties}]
indent_size = 4

[Makefile]
indent_style = tab
